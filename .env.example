# Public, non-secret canonical URL used for metadata and sitemaps.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set true only after every launch provider below is configured. In that mode,
# /api/health fails closed if production integrations are incomplete.
REQUIRE_PRODUCTION_SERVICES=false

# Cookie-free, first-party aggregate counters. Collection is disabled unless
# this value is exactly true. No third-party analytics script is used.
ANALYTICS_ENABLED=false

# Optional local/preview seed catalogue. Leave blank for managed D1-only content.
PUBLICATION_CONTENT_MODE=

# Required before the first production admin sign-in.
INITIAL_SUPER_USER_EMAIL=

# Required only when an external scheduler calls POST /api/maintenance.
MAINTENANCE_TOKEN=

# Set true only after one recurring scheduler is enabled and its successful
# execution is monitored. Production readiness fails closed otherwise.
MAINTENANCE_SCHEDULER_ENABLED=false

# Optional locally, but required when production-service enforcement is on.
# Treat all three as secrets: heartbeat URLs commonly contain an embedded key.
MAINTENANCE_HEARTBEAT_URL=
MAINTENANCE_ALERT_WEBHOOK_URL=
MAINTENANCE_ALERT_WEBHOOK_TOKEN=

# Provider integrations. Leave blank locally; all remain launch-time setup.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
# Recommended direct email provider. A complete secure webhook pair takes precedence.
RESEND_API_KEY=
EMAIL_FROM=
MALWARE_SCAN_WEBHOOK_URL=
MALWARE_SCAN_WEBHOOK_TOKEN=
# Recommended direct scanning provider. A complete secure webhook pair takes precedence.
CLOUDMERSIVE_API_KEY=
PARSER_WEBHOOK_URL=
PARSER_WEBHOOK_TOKEN=
# Recommended direct parser. A complete secure webhook pair takes precedence.
# Choose eu for UK/EU document processing; there is no implicit region default.
ADOBE_PDF_SERVICES_CLIENT_ID=
ADOBE_PDF_SERVICES_CLIENT_SECRET=
ADOBE_PDF_SERVICES_REGION=eu

# Recruitment stays fail-closed until all three values reflect an approved
# policy and the provider integrations above are securely configured.
APPLICATION_INTAKE_ENABLED=false
APPROVED_APPLICANT_RETENTION_DAYS=
APPROVED_APPLICATION_PRIVACY_VERSION=
