{
  "name": "ma-watch-website",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:rendered": "node --import ./tests/register-cloudflare-loader.mjs --test tests/rendered-html.test.mjs",
    "test:smoke": "node scripts/smoke-site.mjs",
    "verify:release": "SMOKE_RELEASE_MODE=true node scripts/smoke-site.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm test && NEXT_PUBLIC_SITE_URL=https://mawatch.org npm run build && npm run test:rendered && npm run test:runtime",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler d1 migrations apply DB --local --config wrangler.local.jsonc --persist-to .wrangler/state",
    "test:runtime": "WRANGLER_SEND_METRICS=false node scripts/test-runtime.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.3",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/workers-types": "5.20260804.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.0",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "undici": "7.30.0",
    "image-size": "2.0.4",
    "sharp": "0.35.4"
  },
  "type": "module"
}
